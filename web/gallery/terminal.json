{
  "version": 1,
  "id": "terminal",
  "name": "Terminal",
  "group": "retro",
  "theme": "tokyo",
  "bg": "none",
  "widgets": [
    { "type": "mascot", "y": 214, "px": 7, "walk": 220 },
