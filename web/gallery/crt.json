    { "type": "cells", "source": "ram.pct", "x": 322, "y": 294.4, "size": 26, "cells": 8, "glyph": "block" },
    { "type": "graph", "source": "cpu.temp", "y": 420, "w": 380, "h": 70, "style": "braille", "minutes": 4 },
    { "type": "text", "text": "> _", "x": 128, "y": 518, "size": 26, "font": "mono", "align": "start", "color": "accent" },
    { "type": "text", "text": "{time.seconds}", "x": 512, "y": 518, "size": 20, "font": "mono", "align": "end", "color": "ink3" }
